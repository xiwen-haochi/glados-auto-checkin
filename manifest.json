{
  "manifest_version": 3,
  "name": "GLaDOS 自动签到",
  "version": "1.0.0",
  "description": "在已登录 GLaDOS 的浏览器里，按设定时间打开签到页并点击签到按钮。",
  "permissions": ["alarms", "storage"],
  "host_permissions": ["https://glados.rocks/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GLaDOS 自动签到",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://glados.rocks/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
